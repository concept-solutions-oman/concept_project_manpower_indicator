<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_manpower_current_status_tree" model="ir.ui.view">
            <field name="name">manpower.current.status.tree</field>
            <field name="model">manpower.current.status</field>
            <field name="arch" type="xml">
                <tree string="Current Manpower Status" create="false" edit="false">
                    <field name="employee_id"/>
                    <field name="status"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                </tree>
            </field>
        </record>

        <record id="view_manpower_current_status_search" model="ir.ui.view">
            <field name="name">manpower.current.status.search</field>
            <field name="model">manpower.current.status</field>
            <field name="arch" type="xml">
                <search string="Current Status Search">
                    <!-- Search by Employee -->
                    <field name="employee_id"/>
                    <field name="department_id"/>

                    
                    <!-- Filter by Status -->
                    <filter string="On Duty" name="on_duty" domain="[('status','=','on_duty')]"/>
                    <filter string="Off Duty" name="off_duty" domain="[('status','=','off_duty')]"/>
                 
                    <filter string="Today" name="today" domain="[('date', '=', context_today())]"/>
                    <filter name="yesterday" string="Yesterday" domain="[('date', '=', (context_today() - relativedelta(days=1)))]"/> 
                    <filter name="this_month" string="This Month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')), ('date', '&lt;=', context_today())]" /> 
                    <separator/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    
                    <filter name="group_by_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_by_status" string="On/Off Duty" context="{'group_by': 'status'}"/>
                    <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>


                </search>
            </field>
        </record>

        <record id="action_manpower_current_status" model="ir.actions.act_window">
            <field name="name">Current Status</field>
            <field name="res_model">manpower.current.status</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_manpower_current_status_tree"/>
            <field name="search_view_id" ref="view_manpower_current_status_search"/>
            <field name="context">{ "search_default_today": 1}</field>
        </record>

        <menuitem id="menu_manpower_current_status"
                name="Current Status"
                parent="project.menu_project_report"
                action="action_manpower_current_status"
                sequence="20"/>
    </data>
</odoo>