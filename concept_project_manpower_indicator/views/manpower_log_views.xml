<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_manpower_log_tree" model="ir.ui.view">
            <field name="name">manpower.log.tree</field>
            <field name="model">manpower.log</field>
            <field name="arch" type="xml">
                <tree string="Manpower Log" create="false" >
                    <field name="date"/>
                    <field name="employee_id"/>
                    <field name="status"/>
                    <field name="start_time"/>
                    <field name="end_time"/>
                    
                </tree>
            </field>
        </record>

        <!-- Add a search view -->
        <record id="view_manpower_log_search" model="ir.ui.view">
            <field name="name">manpower.log.search</field>
            <field name="model">manpower.log</field>
            <field name="arch" type="xml">
                <search string="Manpower Log Search">
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <filter string="On Duty" name="on_duty" domain="[('status','=','on_duty')]"/>
                    <filter string="Off Duty" name="off_duty" domain="[('status','=','off_duty')]"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('date', '=', context_today())]"/>
                    <filter name="yesterday" string="Yesterday" domain="[('date', '=', (context_today() - relativedelta(days=1)))]"/> 
                    <filter name="this_month" string="This Month" domain="[('date', '&gt;=', context_today().strftime('%Y-%m-01')), ('date', '&lt;=', context_today())]" /> 
                    <separator/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                    <filter name="group_by_status" string="Off/On Duty" context="{'group_by': 'status'}"/>
                    <filter name="group_by_department" string="Department" context="{'group_by': 'department_id'}"/>
                    


                    
                </search>
            </field>
        </record>

        <record id="action_manpower_log" model="ir.actions.act_window">
            <field name="name">Manpower Log</field>
            <field name="res_model">manpower.log</field>
            <field name="view_mode">tree</field>
            <field name="view_id" ref="view_manpower_log_tree"/>
            <field name="search_view_id" ref="view_manpower_log_search"/>
            <field name="context">{ "search_default_today": 1}</field>
        </record>



        <menuitem id="menu_manpower_log" 
                  name="Manpower Log" 
                  parent="project.menu_project_report" 
                  action="action_manpower_log" 
                  sequence="10"/>
    </data>
</odoo>